# Supabase — Project Settings → Database → Connection string
# "Transaction" mode (port 6543) — used by Prisma at runtime
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# "Session" mode — used by Prisma Migrate
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Resend — resend.com → API Keys
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"

# The "from" address for outgoing alert emails
# Must be a verified domain in your Resend account
RESEND_FROM_EMAIL="alerts@yourdomain.com"

# NewsAPI — newsapi.org → Get API Key
NEWSAPI_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Secret shared between Vercel Cron and the /api/ingest endpoint
# Generate with: openssl rand -hex 32
CRON_SECRET="your-cron-secret-here"

# Secret for accessing the /admin pages via ?key= query param
# Generate with: openssl rand -hex 16
ADMIN_API_KEY="your-admin-key-here"